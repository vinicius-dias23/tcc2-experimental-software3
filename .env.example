# Copie para .env e ajuste. O docker compose e os scripts Python leem este arquivo.

# Pasta com o dataset RetailRocket preparado por scripts/dados/preparar_retailrocket.py
# (operacoes.csv, itens.csv e categorias.csv). Use ./ no início para caminhos relativos.
RETAILROCKET_DATA_DIR=./data/retailrocket
# Quantas operações de operacoes.csv entram no experimento (0 = todas). As primeiras
# SEED_FRACTION delas são gravadas direto nas bases; o restante vira carga pela API.
RETAILROCKET_MAX_OPS=1000000
SEED_FRACTION=0.7

# Software A (Domain Events): tempo máximo que a requisição espera o broker confirmar o evento
# e resposta ao cliente quando a publicação falha após o commit (success ou error).
PUBLISH_TIMEOUT=5s
PUBLISH_MAX_ATTEMPTS=10
PUBLISH_FAILURE_RESPONSE=success
# Retentativa em memória do evento que falhou (sem Outbox: se o processo morrer, perde-se):
# tentativas, espera antes da primeira, multiplicador das seguintes e limite de eventos na
# memória. Padrão 3 tentativas a 1 s, 2 s e 4 s. PUBLISH_RETRY_ATTEMPTS=0 desliga.
PUBLISH_RETRY_ATTEMPTS=3
PUBLISH_RETRY_BACKOFF=1s
PUBLISH_RETRY_MULTIPLIER=2
PUBLISH_RETRY_BUFFER=10000

# Software B (CDC): intervalo de gravação de offsets do Kafka Connect e tempo máximo de
# entrega do produtor do Connect (o máximo evita que a tarefa falhe em janelas longas).
CDC_OFFSET_FLUSH_INTERVAL_MS=60000
CDC_PRODUCER_DELIVERY_TIMEOUT_MS=2147483647
# Reinício automático da tarefa do Debezium em FAILED (connect-watchdog), com a mesma política
# do Software A. CONNECT_RESTART_ATTEMPTS=0 desliga. O contador zera depois de
# CONNECT_RESTART_RESET_AFTER com o conector em RUNNING.
CONNECT_RESTART_ATTEMPTS=3
CONNECT_RESTART_BACKOFF=1s
CONNECT_RESTART_MULTIPLIER=2
CONNECT_RESTART_RESET_AFTER=60s

# Comum
KAFKA_PARTITIONS=6
CONSUMER_WORKERS=3
